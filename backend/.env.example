# Banco PostgreSQL
DATABASE_URL="postgresql://lend:lend@localhost:5432/lendcontrol?schema=public"
# Troque por um segredo forte (ex.: openssl rand -hex 32)
JWT_SECRET="troque-este-segredo"
PORT=3000

# Storage privado dos documentos (links assinados valem 5 minutos)
STORAGE_DIR=./storage/private
STORAGE_SIGNING_SECRET="outro-segredo-forte"
BACKUP_DIR=./storage/backups

# E-mail do backup de segunda 08:00 (o destinatário é configurado no painel)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp via Evolution API (opcional — sem isso usa links wa.me)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=lendcontrol
